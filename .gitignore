# Secrets & Signing
# NEVER commit signing keys. The APNs key is provided to the backend at runtime
# via the APNS_PRIVATE_KEY env var (Supabase edge-function secret), not from a file.
*.p8
*.pem
*.key
*.p12
*.mobileprovision
.env
.env.local
secrets.json
Fit33/Secrets.swift

# Large files (videos should be in cloud storage)
All Workout Videos/
*.mp4
*.mov
*.wav
1201-CLASSIC-GYM-videos*/
BuiltSimple_Backups/
.git_backup*/

# Temporary SQL files (keep schema/migration files)
temp_*.sql
test_*.sql

# Node modules (if using any JS tools)
node_modules/
package-lock.json
yarn.lock

