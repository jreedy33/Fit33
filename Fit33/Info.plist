<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Fit33</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.gofit.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fit33</string>
			</array>
		</dict>
	</array>
	<!-- 2026-05-02 (per-user request): the cardio "Run with Strava"
	     handoff button on `CardioGoalSetupView` calls
	     `UIApplication.shared.canOpenURL("strava://...")` to decide
	     whether to deep-link or fall back to the App Store. Without
	     `LSApplicationQueriesSchemes` declaring `strava`, iOS would
	     refuse the query and the user would always get the App Store
	     fallback even when Strava is installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>strava</string>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-8809892203317185~4284827887</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.healthcare-fitness</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppleMusicUsageDescription</key>
	<string>Fit33 lets you control your music during workouts without leaving the app.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Fit33 uses Bluetooth to connect to gym equipment like treadmills, bikes, and rowing machines to sync your workout data in real-time.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Fit33 uses Bluetooth to connect to fitness equipment and heart rate monitors.</string>
	<key>NSCameraUsageDescription</key>
	<string>Fit33 uses your camera to scan QR codes to add friends, scan food barcodes, and take profile photos.</string>
	<key>NSContactsUsageDescription</key>
	<string>Fit33 uses your contacts to help you find friends who are already using the app.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Fit33 needs access to your photo library to set a profile picture.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Fit33 uses this to show you relevant ads and support free features. Your data is never sold.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Fit33 reads your steps, active energy, workouts, body weight, height, biological sex, and date of birth from Apple Health to power your daily activity rings, accurate calorie calculations, workout tracking, recovery scoring, and personalized program recommendations.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Fit33 writes the workouts you complete in the app — including workout type, duration, and active energy burned — back to Apple Health so your fitness data stays in one place across all your devices.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Fit33 uses your location to track your outdoor runs even when the app is in the background, ensuring accurate distance and route recording.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Fit33 uses your location to track your outdoor runs, showing your route, distance, and pace.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>CFBundleGetInfoString</key>
	<string></string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gofit.app.challengeSync</string>
		<string>com.gofit.app.challengeSyncProcessing</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<!-- ⚡️ Cold-start UX fix (2026-04-25):
		     `UILaunchScreen` was previously `<dict/>` (empty), which makes
		     iOS render a SOLID WHITE screen for the entire 1.9–3.5s
		     launch-screen → app-window transition. That's the user-
		     visible "long startup white screen" complaint — not anything
		     in our app code. By specifying a color asset that matches the
		     dashboard's `appBackgroundTop` in both light and dark modes,
		     iOS now shows a screen that visually matches the app the
		     instant the icon is tapped. There's no more "flash of white"
		     between launch and the dashboard rendering. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
