#!/bin/sh
# .githooks/pre-commit — Fit33 local safety net
#
# Activate once:
#   git config core.hooksPath .githooks
#
# Runs the following checks:
#   1. classifier_lint.py in warn-only mode, scoped to staged Fit33/*.swift
#      (warn-only unless STRICT_CLASSIFIER=1).
#   2. pre_commit_migration_check.sh — HARD FAILS the commit when staged
#      `supabase/*.sql` files are missing from `supabase/MIGRATION_INDEX.md`
#      (Sprint 4 AGD-9). The migration index is the canonical release-train
#      manifest; drift here is what causes "client ships against a migration
#      that never reaches prod" (audit 2026-04-27 finding #5).

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)

STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^Fit33/.*\.swift$' || true)

# Classifier lint on staged files (when there are any).
if [ -n "$STAGED_SWIFT" ]; then
  if [ -x "$REPO_ROOT/scripts/classifier_lint.py" ] || [ -f "$REPO_ROOT/scripts/classifier_lint.py" ]; then
    FLAGS=""
    if [ "${STRICT_CLASSIFIER:-0}" = "1" ]; then
      FLAGS="--strict"
    fi
    # Scan per-file so the output only reflects files touched by this commit.
    FAILED=0
    for f in $STAGED_SWIFT; do
      if ! python3 "$REPO_ROOT/scripts/classifier_lint.py" $FLAGS --root "$REPO_ROOT/$f" 2>/dev/null; then
        FAILED=1
      fi
    done
    if [ "$FAILED" = "1" ] && [ "${STRICT_CLASSIFIER:-0}" = "1" ]; then
      echo ""
      echo "pre-commit: classifier_lint.py --strict found violations in staged files." >&2
      echo "            Re-run 'git commit' without STRICT_CLASSIFIER=1 to bypass, or" >&2
      echo "            add '// classifier_lint:allow' to the legitimate catch blocks." >&2
      exit 1
    fi
  fi
fi

# Migration index drift guard — hard-fails when staged supabase/*.sql files
# are not registered in MIGRATION_INDEX.md. Self-checks for staged migrations
# and exits 0 cleanly when none are present, so this runs unconditionally.
if [ -f "$REPO_ROOT/scripts/pre_commit_migration_check.sh" ]; then
  if ! bash "$REPO_ROOT/scripts/pre_commit_migration_check.sh"; then
    exit 1
  fi
fi

# Resolves: directive existence check — when staged migrations contain
# `-- Resolves: <fingerprint>` directives, verify each fingerprint exists
# in either bug_intelligence_fingerprints or bug_intel_resolved_history.
# This catches typos / stale hashes before the migration deploys. We use
# --existence-only because the FP is by definition "still open" pre-deploy
# (the migration hasn't run yet); a post-deploy daily audit handles the
# stricter "did the directive actually drain it?" check.
#
# Skips silently when no migrations are staged or audit script is missing.
# Skips silently when SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are unset
# (offline-safe — never blocks an offline commit).
STAGED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=AM | grep -E '^supabase/.*\.sql$' || true)

if [ -n "$STAGED_MIGRATIONS" ] && [ -f "$REPO_ROOT/scripts/audit_resolves_directives.py" ]; then
  HAS_DIRECTIVES=0
  for f in $STAGED_MIGRATIONS; do
    if grep -qiE '^[[:space:]\*\-/]*Resolves:[[:space:]]*[a-f0-9]{32}' "$REPO_ROOT/$f" 2>/dev/null; then
      HAS_DIRECTIVES=1
      break
    fi
  done

  if [ "$HAS_DIRECTIVES" = "1" ]; then
    if [ -n "$SUPABASE_URL" ] && [ -n "$SUPABASE_SERVICE_ROLE_KEY" ] || [ -f "$REPO_ROOT/.env" ]; then
      DRIFT=0
      for f in $STAGED_MIGRATIONS; do
        if ! python3 "$REPO_ROOT/scripts/audit_resolves_directives.py" \
                --migration "$f" \
                --existence-only \
                --quiet-when-clean \
                --strict 2>/dev/null; then
          DRIFT=1
        fi
      done
      if [ "$DRIFT" = "1" ] && [ "${STRICT_RESOLVES:-0}" = "1" ]; then
        echo ""
        echo "pre-commit: Resolves: directive references a fingerprint not in the DB." >&2
        echo "            Likely a typo / stale hash. Set STRICT_RESOLVES=0 to bypass." >&2
        exit 1
      fi
    fi
  fi
fi

exit 0
